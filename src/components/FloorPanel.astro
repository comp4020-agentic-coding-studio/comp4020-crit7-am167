---
import { bookingsOn, levelsOf, roomsInBuilding } from "../lib/booking";
import { deskArea, isDesk, labelFor, shortCode, type RoomKind } from "../lib/floorplan";
import { levelName, levelTag, levelTitle } from "../lib/levels";
import { buildingUrl, roomSlug } from "../lib/links";
import type { Building, User } from "../lib/schema";
import { SLOTS, currentSlot, dateLabel, today } from "../lib/slots";
import DateStrip from "./DateStrip.astro";
import FloorPlan from "./FloorPlan.astro";
import MapPanel from "./MapPanel.astro";

// The floor stage's panel: which level you're on, the other levels one tap
// away, and everything bookable on this one.
//
// A floor is a few rooms and a lot of desks, and the two want different
// lists. Each room gets a row with its day drawn as a strip, so you can scan
// for a free afternoon without opening each one. Desks come in study areas
// of up to fifty: each area folds up to one line saying how many are free,
// and opens to a grid of desk numbers shaded by how much of the day each has
// left. A strip per desk would be a list hundreds of rows long.
//
// Rooms and desks are submit buttons in one GET form rather than links: a
// link each would hand a crawler thousands of pages. Picking one goes to the
// building URL with `room=`, which redirects to that room's own page.
//
// The same panel sits behind a room's dialog, where the dialog carries the
// page's heading and date, so both are switchable here.

interface Props {
  building: Building;
  floor: number;
  date: string;
  user?: User;
  /** the room whose dialog is open over this level, if any */
  selected?: string;
  /** false behind a room dialog, which owns the page's <h1> */
  primary?: boolean;
}

const { building, floor, date, user, selected, primary = true } = Astro.props;

const levels = levelsOf(building, date);
const here = levels[floor];
const places = roomsInBuilding(building.id).filter((room) => room.floor === floor);
const bookings = bookingsOn(
  places.map((room) => room.id),
  date,
);
const isToday = date === today();
const pastBefore = isToday ? currentSlot() : -1;

type SlotState = "free" | "busy" | "mine" | "past";
const rows = places.map((room) => {
  const slots: SlotState[] = new Array(SLOTS).fill("free");
  for (let s = 0; s < Math.min(pastBefore, SLOTS); s++) slots[s] = "past";
  for (const booking of bookings.filter((b) => b.roomId === room.id)) {
    const mine = user !== undefined && booking.userId === user.id;
    for (let s = booking.startSlot; s < booking.endSlot && s < SLOTS; s++) {
      slots[s] = mine ? "mine" : "busy";
    }
  }
  const free = slots.filter((state) => state === "free").length;
  return {
    room,
    slug: roomSlug(room.code),
    slots,
    free,
    yours: slots.includes("mine"),
    freeNow: isToday && pastBefore >= 0 && pastBefore < SLOTS && slots[pastBefore] === "free",
    // how much of what's left of the day is still free, for a desk's shade
    share: free / Math.max(1, SLOTS - Math.max(0, pastBefore)),
  };
});

const roomRows = rows.filter((row) => !isDesk(row.room.kind));
const deskRows = rows.filter((row) => isDesk(row.room.kind));

/** study areas, in the order they run along the corridor */
const areas = [...new Set(deskRows.map((row) => deskArea(row.room.code) ?? "?"))].map((area) => {
  const desks = deskRows.filter((row) => (deskArea(row.room.code) ?? "?") === area);
  return {
    area,
    desks,
    withTime: desks.filter((row) => row.free > 0).length,
    freeNow: desks.filter((row) => row.freeNow).length,
    quiet: desks.every((row) => (JSON.parse(row.room.features) as string[]).includes("quiet")),
    open: desks.some((row) => row.slug === selected || row.yours),
  };
});

const pct = (free: number, capacity: number) => Math.round((free / Math.max(1, capacity)) * 100);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const Heading = primary ? "h1" : "h2";
const deskTitle = (row: (typeof rows)[number]) =>
  `${row.room.code}, ${row.yours ? "yours, " : ""}${row.free === 0 ? "full" : `${row.free / 2} h free`}`;
---

<MapPanel label={`${building.name}, ${levelName(floor)}`} noun="places" folded={!primary}>
  <Fragment slot="head">
    <ol class="crumbs">
      <li><a href={`/?date=${date}`}>Campus</a></li>
      <li><a href={buildingUrl(building.slug, { date })}>{building.name}</a></li>
      <li aria-current="page">{levelTitle(floor)}</li>
    </ol>
    <Heading class="mappanel-title">
      {building.name}, {levelName(floor)}
    </Heading>
    <p class="mappanel-sub">
      {plural(roomRows.length, "room")} · {plural(deskRows.length, "desk")}
      {here && ` · ${pct(here.free, here.capacity)}% free ${dateLabel(date)}`}
      <span class="live-only"> · pick one on the map</span>
    </p>
    <nav class="levelchips" aria-label={`Levels of ${building.name}`}>
      {
        [...levels].reverse().map((entry) => (
          <a
            href={buildingUrl(building.slug, { date, floor: entry.level })}
            aria-current={entry.level === floor ? "page" : undefined}
          >
            {levelTag(entry.level)}
            <span class="visually-hidden">
              , {entry.rooms} rooms and {entry.desks} desks, {pct(entry.free, entry.capacity)}% free
            </span>
          </a>
        ))
      }
    </nav>
    {primary && <DateStrip date={date} action={buildingUrl(building.slug)} keep={{ floor }} />}
  </Fragment>

  {
    rows.length === 0 ? (
      <div class="empty">
        <p>Nothing bookable on this level.</p>
      </div>
    ) : (
      <form class="places" method="get" action={buildingUrl(building.slug)} data-places>
        <input type="hidden" name="date" value={date} />
        <div class="section-head">
          <h2 class="mappanel-section">Rooms · {dateLabel(date)}</h2>
          <ul class="legend">
            <li>
              <span class="swatch swatch-free" /> Free
            </li>
            <li>
              <span class="swatch swatch-busy" /> Taken
            </li>
            <li>
              <span class="swatch swatch-mine" /> Yours
            </li>
            {pastBefore > 0 && (
              <li>
                <span class="swatch swatch-gone" /> Already been
              </li>
            )}
          </ul>
        </div>
        <ul class="roomlist">
          {roomRows.map(({ room, slug, slots, free, yours }) => (
            <li>
              <button
                class="roomrow"
                type="submit"
                name="room"
                value={slug}
                aria-current={slug === selected ? "true" : undefined}
                data-map-hover={`room:${slug}`}
              >
                <span class="roomrow-code code">{room.code}</span>
                <span class="roomrow-free">
                  {yours ? "Yours · " : ""}
                  {free === 0 ? "Full" : `${free / 2} h free`}
                </span>
                <span class="roomrow-meta muted">
                  {labelFor(room.kind as RoomKind)} · {room.capacity} seats
                </span>
                {/* the day, 08:00 to 20:00, one tick per half hour; the
                    text beside it says the same thing in words */}
                <span class="daybar" aria-hidden="true">
                  {slots.map((state) => (
                    <i data-state={state} />
                  ))}
                </span>
              </button>
            </li>
          ))}
        </ul>

        {areas.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="mappanel-section">Study desks · {dateLabel(date)}</h2>
              <p class="deskkey muted">
                <span class="deskkey-bar" aria-hidden="true" /> how much of the day is free
              </p>
            </div>
            <div class="deskareas">
              {areas.map(({ area, desks, withTime, freeNow, quiet, open }) => (
                <details class="deskarea" open={open}>
                  <summary>
                    <span class="deskarea-name">
                      Study area <span class="code">{area}</span>
                      {quiet && <span class="pill">quiet</span>}
                    </span>
                    <span class="deskarea-stat">
                      {isToday && pastBefore >= 0 && pastBefore < SLOTS
                        ? `${freeNow} of ${desks.length} free now`
                        : `${withTime} of ${desks.length} with time free`}
                    </span>
                  </summary>
                  <ul class="desks">
                    {desks.map((row) => (
                      <li>
                        <button
                          class="desk"
                          type="submit"
                          name="room"
                          value={row.slug}
                          aria-current={row.slug === selected ? "true" : undefined}
                          aria-label={deskTitle(row)}
                          data-map-hover={`room:${row.slug}`}
                          data-state={row.yours ? "mine" : row.free === 0 ? "full" : "free"}
                          style={`--share:${row.share.toFixed(3)}`}
                        >
                          <span class="code">{shortCode(row.room.code)}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          </>
        )}
      </form>
    )
  }

  {/* the flat plan is what a visitor without the 3D map sees instead of it */}
  <div class="fallback-only">
    <FloorPlan
      building={building}
      rooms={places}
      bookings={bookings}
      date={date}
      userId={user?.id}
    />
  </div>
</MapPanel>
