---
import { BUILDINGS } from "../data/campus";
import type { BookingRow } from "../lib/booking";
import { isDesk, planCores } from "../lib/floorplan";
import { roomSlug } from "../lib/links";
import { swatchVars } from "../lib/palette";
import type { Building, Room } from "../lib/schema";
import { SLOTS } from "../lib/slots";

// The floor, flat. Real building outline (OpenStreetMap), invented rooms
// laid out inside it by src/lib/floorplan.ts.
//
// This is server-rendered SVG, always in the page: it's what a visitor sees
// before the 3D scene finishes loading, what they keep if WebGL isn't
// available or they've asked for reduced motion. Tapping a room or desk opens
// it, but the shapes aren't links: a link per desk hands a crawler thousands
// of pages. So the plan is one labelled picture, and the list of rooms and
// desks beside it (buttons in a form) is the way in by keyboard, screen
// reader, or with JavaScript off.

interface Props {
  building: Building;
  rooms: Room[];
  bookings: BookingRow[];
  date: string;
  userId?: number;
}

const { building, rooms, bookings, date, userId } = Astro.props;

const plan = JSON.parse(building.plan) as Array<[number, number]>;
const xs = plan.map((p) => p[0]);
const zs = plan.map((p) => p[1]);
const pad = 4;
const minX = Math.min(...xs) - pad;
const minZ = Math.min(...zs) - pad;
const width = Math.max(...xs) - minX + pad;
const height = Math.max(...zs) - minZ + pad;

const outline = `${plan.map(([x, z]) => `${x.toFixed(1)},${z.toFixed(1)}`).join(" ")}`;

/** booked half hours per room, and who holds them */
const used = new Map<number, number>();
const mine = new Set<number>();
for (const booking of bookings) {
  used.set(booking.roomId, (used.get(booking.roomId) ?? 0) + (booking.endSlot - booking.startSlot));
  if (userId !== undefined && booking.userId === userId) mine.add(booking.roomId);
}

/** stairs, lifts and toilets: drawn, not bookable */
const source = BUILDINGS.find((b) => b.code === building.code);
const cores = (source ? planCores(source) : []).map((core) => ({
  ...core,
  deg: (core.angle * 180) / Math.PI,
}));

const cells = rooms.map((room) => {
  const booked = used.get(room.id) ?? 0;
  const free = SLOTS - booked;
  const desk = isDesk(room.kind);
  return {
    room,
    free,
    desk,
    what: desk ? "desk" : `seats ${room.capacity}`,
    state: mine.has(room.id) ? "mine" : free === 0 ? "full" : "free",
    // fill opacity tracks how free the room is, so a busy floor reads dark
    tint: Math.max(0.08, free / SLOTS),
  };
});

// Every rect on a floor is turned to the same corridor axis, so rather than
// a rotate() on each of several hundred desks, each angle gets one <g>
// turned about the origin, and a rect sits at its centre turned back the
// other way. The page is a lot lighter for it on a big floor.
function turned<T extends { angle: number; cx: number; cz: number; w: number; d: number }>(
  items: T[],
): Array<{ deg: string; items: Array<T & { x: string; y: string }> }> {
  const groups = new Map<string, Array<T & { x: string; y: string }>>();
  for (const item of items) {
    const deg = ((item.angle * 180) / Math.PI).toFixed(3);
    const cos = Math.cos(-item.angle);
    const sin = Math.sin(-item.angle);
    const u = item.cx * cos - item.cz * sin;
    const v = item.cx * sin + item.cz * cos;
    const list = groups.get(deg) ?? [];
    list.push({ ...item, x: (u - item.w / 2).toFixed(2), y: (v - item.d / 2).toFixed(2) });
    groups.set(deg, list);
  }
  return [...groups].map(([deg, list]) => ({ deg, items: list }));
}

const coreGroups = turned(cores);
const cellGroups = turned(cells.map((cell) => ({ ...cell, ...cell.room })));
---

<figure
  class="floorplan"
  data-floorplan
  data-building={building.slug}
  data-date={date}
  style={swatchVars(building.code)}
>
  <svg
    viewBox={`${minX.toFixed(1)} ${minZ.toFixed(1)} ${width.toFixed(1)} ${height.toFixed(1)}`}
    role="img"
    aria-label={`Floor plan of ${building.name}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <polygon class="fp-shell" points={outline}></polygon>
    {
      coreGroups.map(({ deg, items }) => (
        <g transform={`rotate(${deg})`} aria-hidden="true">
          {items.map((core) => (
            <rect class="fp-core" x={core.x} y={core.y} width={core.w} height={core.d} />
          ))}
        </g>
      ))
    }
    {
      cellGroups.map(({ deg, items }) => (
        <g transform={`rotate(${deg})`}>
          {items.map(({ room, free, desk, what, state, tint, x, y }) => (
            <g
              class="fp-room"
              data-room={roomSlug(room.code)}
              data-kind={desk ? "desk" : "room"}
              data-state={state}
            >
              {/* a room gets a <title>, the hover tooltip. A desk is too
                  small to hover usefully, and there are hundreds, so it goes
                  without */}
              {!desk && (
                <title>
                  {room.code} — {what} — {free} of {SLOTS} half hours free
                </title>
              )}
              <rect
                x={x}
                y={y}
                width={room.w}
                height={room.d}
                style={`--tint:${tint.toFixed(2)}`}
                rx={desk ? "0.12" : "0.4"}
              />
            </g>
          ))}
        </g>
      ))
    }
  </svg>
  <figcaption class="muted">
    Outline is the real building; the rooms, desks and grey stair and lift cores inside it are
    invented. Tap a room or desk to see its day.
  </figcaption>
</figure>

<script>
  import { navigate } from "astro:transitions/client";

  // A tap on a room or desk opens it. Wired on every page load, because the
  // router swaps the plan out under us.
  document.addEventListener("astro:page-load", () => {
    for (const plan of document.querySelectorAll<HTMLElement>("[data-floorplan]")) {
      plan.addEventListener("click", (event) => {
        const room = (event.target as Element).closest("[data-room]")?.getAttribute("data-room");
        const { building, date } = plan.dataset;
        if (room && building && date) void navigate(`/b/${building}/${room}/?date=${date}`);
      });
    }
  });
</script>
