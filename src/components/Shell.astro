---
import { ClientRouter } from "astro:transitions";
import { ATTRIBUTION } from "../data/campus";
import { nameOf } from "../lib/auth";
import type { User } from "../lib/schema";
import { chosenTheme } from "../lib/theme";
import "../styles.css";

// Every page's frame: head, the one nav landmark the invariants look for,
// and the footer that carries OpenStreetMap's attribution (the campus
// footprints are ODbL, so the credit isn't optional).
//
// <ClientRouter /> is here for one reason: it lets the WebGL canvas survive
// a page navigation (see CampusScene.astro), so clicking a building flies
// the camera in rather than rebooting the whole scene.
//
// The map pages use the "map" layout: the map fills the window under the
// masthead and nothing scrolls, so there's no page footer to scroll down to
// — the attribution moves into the map's corner instead (MapFrame.astro).
//
// Light or dark follows the device until someone picks one with the
// masthead's switch (src/lib/theme.ts); a pick is rendered here as
// `data-theme`, so the page arrives in it.

interface Props {
  title: string;
  /** which nav item is the page you're on */
  current?: "map" | "bookings" | "about";
  user?: User;
  /** where to come back to after signing in */
  next?: string;
  /** "map" fills the window with the map and drops the footer */
  layout?: "page" | "map";
}

const {
  title,
  current,
  user,
  next = Astro.url.pathname + Astro.url.search,
  layout = "page",
} = Astro.props;

/** "Alex Nguyen" → "AN": who's signed in, in the width a phone has spare */
const initials = user
  ? nameOf(user)
      .split(/\s+/)
      .map((part) => part[0] ?? "")
      .join("")
      .slice(0, 2)
      .toUpperCase()
  : "";

const theme = chosenTheme(Astro.cookies);
---

<!doctype html>
<html lang="en-AU" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="ANU Room Booking — find and book a room at ANU Acton on a live campus map, floor by floor."
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={layout === "map" ? "map-body" : undefined}>
    <header class="masthead">
      <a class="brand" href="/">
        {/* An original mark in ANU's black and gold — a shield with an open
            book — not the University's crest: that's a trademark, and this
            is a prototype that says it isn't an ANU service. */}
        <svg class="brand-mark" viewBox="0 0 32 36" aria-hidden="true" focusable="false">
          <path d="M16 1.5 29.5 5.5V17c0 8.6-5.6 14.6-13.5 17.5C8.1 31.6 2.5 25.6 2.5 17V5.5Z" />
          <path
            class="brand-book"
            d="M7.5 12.8c3.2-1 6.1-.6 8.5 1.2v11.6c-2.4-1.6-5.3-2-8.5-1.1Zm17 0c-3.2-1-6.1-.6-8.5 1.2v11.6c2.4-1.6 5.3-2 8.5-1.1Z"
          />
        </svg>
        <span class="brand-name"><b>ANU</b> Room Booking</span>
      </a>
      <nav aria-label="Main">
        <a href="/" aria-current={current === "map" ? "page" : undefined}>Campus</a>
        <a href="/bookings/" aria-current={current === "bookings" ? "page" : undefined}>
          My bookings
        </a>
        <a href="/readme/" aria-current={current === "about" ? "page" : undefined}>About</a>
      </nav>
      <span class="spacer"></span>
      {/* Both ways are always here; the stylesheet shows whichever isn't the
          theme on screen, which it knows even when the server doesn't (a
          device set to dark, no choice made yet). */}
      <form method="post" action="/api/theme" class="theme-switch">
        <input type="hidden" name="next" value={next} />
        <button
          class="btn btn-quiet btn-sm btn-icon theme-to-dark"
          type="submit"
          name="theme"
          value="dark"
          aria-label="Switch to dark mode"
          title="Switch to dark mode"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
          </svg>
        </button>
        <button
          class="btn btn-quiet btn-sm btn-icon theme-to-light"
          type="submit"
          name="theme"
          value="light"
          aria-label="Switch to light mode"
          title="Switch to light mode"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.2" />
            <path
              d="M12 2v2.6M12 19.4V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.6M19.4 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
            />
          </svg>
        </button>
      </form>
      {
        user ? (
          <form method="post" action="/api/session" class="whoami">
            <input type="hidden" name="action" value="sign-out" />
            <span class="whoami-who">
              <b>{nameOf(user)}</b> <span class="uid">{user.uniId}</span>
            </span>
            <span class="whoami-initials" aria-hidden="true" title={nameOf(user)}>
              {initials}
            </span>
            <button class="btn btn-quiet btn-sm" type="submit">Sign out</button>
          </form>
        ) : (
          <form class="signin" method="get" action="/login/">
            <input type="hidden" name="next" value={next} />
            <button class="btn btn-sm" type="submit">Sign in</button>
          </form>
        )
      }
    </header>

    <main class={layout === "map" ? "map-main" : undefined}>
      <slot />
    </main>

    {
      layout === "page" && (
        <footer class="page-foot">
          <p>
            Building footprints {ATTRIBUTION}, licensed{" "}
            <a href="https://www.openstreetmap.org/copyright" rel="license noreferrer">
              ODbL
            </a>
            . Floor layouts, room numbers and every booking in here are invented — this is a
            COMP4020 prototype, not an ANU service. <a href="/readme/">What this is</a>.
          </p>
        </footer>
      )
    }
  </body>
</html>

<script>
  import { THEME_COOKIE, THEME_MAX_AGE, isTheme } from "../lib/theme";

  // With script, switching needn't be a round trip: write the cookie the
  // server would have, re-theme in place, and tell the map (src/scenes/
  // mount.ts), which paints its own colours. Capture phase, so this runs
  // before the view-transition router would turn the POST into a navigation.
  document.addEventListener(
    "submit",
    (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches(".theme-switch")) return;
      const theme = (event.submitter as HTMLButtonElement | null)?.value;
      if (!isTheme(theme)) return;
      event.preventDefault();
      const secure = location.protocol === "https:" ? ";secure" : "";
      document.cookie = `${THEME_COOKIE}=${theme};path=/;max-age=${THEME_MAX_AGE};samesite=lax${secure}`;
      document.documentElement.dataset.theme = theme;
      window.dispatchEvent(new CustomEvent("theme:change"));
      // the button just pressed has gone; keep focus on the switch
      form.querySelector<HTMLButtonElement>(`button:not([value="${theme}"])`)?.focus();
    },
    true,
  );
</script>
