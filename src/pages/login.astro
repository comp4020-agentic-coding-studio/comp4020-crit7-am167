---
import Shell from "../components/Shell.astro";
import { MAX_PASSWORD, currentUser } from "../lib/auth";
import { safeNext as toSafeNext } from "../lib/links";
import { DEMO_PASSWORD, DEMO_USERS } from "../lib/seed";

// Signed-out pages still return 200 rather than redirecting: the spec's
// invariants fetch every route without a session and require a page.

const user = currentUser(Astro.cookies);
const safeNext = toSafeNext(Astro.url.searchParams.get("next"));

const ERRORS: Record<string, string> = {
  "bad-id": "A uni ID is a 'u' and seven digits. The 'u' is filled in, so type just the digits.",
  "bad-password": "That password doesn't match this uni ID. New IDs pick their own on first use.",
  "long-password": `Passwords can be up to ${MAX_PASSWORD} characters.`,
};
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
---

<Shell title="Sign in · ANU Room Booking" user={user ?? undefined} next={safeNext}>
  <div class="prose stack">
    <div>
      <h1>Sign in</h1>
      <p class="lede">
        Bookings belong to someone, so the app needs to know who you are. It doesn't check with the
        University — <strong>any</strong> well-formed uni ID works, and the first time one is used it
        keeps whatever password you type.
      </p>
    </div>

    {error && <p class="notice notice-error">{error}</p>}

    {
      user ? (
        <p class="notice notice-ok">
          You're already signed in as {user.uniId}. <a href="/bookings/">See your bookings</a>.
        </p>
      ) : (
        <form method="post" action="/api/session" class="panel panel-pad stack-sm">
          <input type="hidden" name="next" value={safeNext} />
          <div>
            <label for="uniId">Uni ID</label>
            <div class="input-affix">
              <span class="input-prefix" aria-hidden="true">u</span>
              <input
                id="uniId"
                name="uniId"
                required
                placeholder="1234567"
                inputmode="numeric"
                maxlength="7"
                pattern="[0-9]{7}"
                title="Seven digits — the u is already there"
                aria-describedby="uniId-hint"
                autocomplete="username"
                spellcheck="false"
              />
            </div>
            <p class="field-hint" id="uniId-hint">The 'u' is filled in. Type your seven digits.</p>
          </div>
          <div>
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="4"
              maxlength={MAX_PASSWORD}
              autocomplete="current-password"
            />
          </div>
          <div>
            <button class="btn btn-primary" type="submit">Sign in</button>
          </div>
        </form>
      )
    }

    <section class="panel panel-pad stack-sm">
      <h2>People already on this campus</h2>
      <p class="muted" style="margin:0">
        Their bookings are what fills the map. Password for all of them:
        <code class="code">{DEMO_PASSWORD}</code>
      </p>
      <ul class="cards">
        {
          DEMO_USERS.map((person) => (
            <li class="card">
              <div class="card-title">
                <span class="code">{person.uniId}</span>
                <span class="pill">{person.role}</span>
              </div>
              <p class="card-meta">{person.displayName}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Shell>

<script>
  // The form already holds the u, so the box takes digits only. maxlength
  // stops a typed eighth digit on its own; this catches what it can't — a
  // pasted or autofilled "u1234567" (which maxlength would cut to "u123456")
  // and stray spaces or letters. Delegated from document so it survives
  // view-transition navigations. With no JS the pattern still guards the
  // form, and the server accepts either shape.
  const digitsOf = (text: string) =>
    text
      .trim()
      .replace(/^u/i, "")
      .replace(/\D/g, "")
      .slice(0, 7);

  const isUniId = (target: EventTarget | null): target is HTMLInputElement =>
    target instanceof HTMLInputElement && target.id === "uniId";

  document.addEventListener("paste", (event) => {
    if (!isUniId(event.target)) return;
    const text = event.clipboardData?.getData("text");
    if (text === undefined) return;
    event.preventDefault();
    event.target.value = digitsOf(text);
  });

  for (const type of ["input", "change"]) {
    document.addEventListener(type, (event) => {
      if (!isUniId(event.target)) return;
      const clean = digitsOf(event.target.value);
      if (clean !== event.target.value) event.target.value = clean;
    });
  }
</script>
