---
import FloorPanel from "../../../components/FloorPanel.astro";
import MapFrame from "../../../components/MapFrame.astro";
import RoomDialog from "../../../components/RoomDialog.astro";
import Shell from "../../../components/Shell.astro";
import { currentUser } from "../../../lib/auth";
import { bookingsOn, buildingBySlug, errorMessage, roomsInBuilding } from "../../../lib/booking";
import { buildingUrl, dayRedirect, roomSlug } from "../../../lib/links";
import { swatchVars } from "../../../lib/palette";
import { SLOTS, currentSlot, isBookableDate, today } from "../../../lib/slots";

// The last stage of the map: the room's level, looked down on, with the
// room's dialog open in front of it. A booking posts from the dialog and
// 303s back here, so it lands with the dialog still open and the room now
// inked as yours on the map behind.

const toDay = dayRedirect(Astro.url);
if (toDay) return Astro.redirect(toDay, 303);

const { slug, room: roomParam } = Astro.params;
const building = slug ? buildingBySlug(slug) : undefined;
const room = building
  ? roomsInBuilding(building.id).find((r) => roomSlug(r.code) === roomParam)
  : undefined;

if (!building || !room) {
  return new Response("No such room", { status: 404 });
}

const user = currentUser(Astro.cookies);
const params = Astro.url.searchParams;
const requested = params.get("date") ?? today();
const date = isBookableDate(requested) ? requested : today();
const bookings = bookingsOn([room.id], date);
const pastBefore = date === today() ? currentSlot() : -1;

// the slot the day strip handed us, if any, else the first free one
const firstFree = Array.from({ length: SLOTS }, (_, i) => i).find(
  (s) => s >= Math.max(0, pastBefore) && !bookings.some((b) => b.startSlot <= s && b.endSlot > s),
);
const requestedStart = Number(params.get("start"));
const start =
  params.has("start") && Number.isInteger(requestedStart)
    ? Math.min(Math.max(requestedStart, Math.max(0, pastBefore)), SLOTS - 1)
    : (firstFree ?? Math.max(0, pastBefore));

const error = errorMessage(params.get("error"));
const justBooked = bookings.find((b) => String(b.id) === params.get("booked"));
const closeHref = buildingUrl(building.slug, { date, floor: room.floor });
---

<Shell
  title={`${room.code} · ${building.name} · ANU Room Booking`}
  current="map"
  user={user ?? undefined}
  layout="map"
>
  <MapFrame
    stage="room"
    style={swatchVars(building.code)}
    scene={{ date, focus: building.slug, floor: room.floor, selected: roomSlug(room.code) }}
  >
    <RoomDialog
      building={building}
      room={room}
      date={date}
      user={user ?? undefined}
      bookings={bookings}
      pastBefore={pastBefore}
      start={start}
      error={error}
      justBooked={justBooked}
      closeHref={closeHref}
    />
    <FloorPanel
      building={building}
      floor={room.floor}
      date={date}
      user={user ?? undefined}
      selected={roomSlug(room.code)}
      primary={false}
    />
  </MapFrame>
</Shell>
