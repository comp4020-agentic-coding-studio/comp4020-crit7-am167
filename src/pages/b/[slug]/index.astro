---
import DateStrip from "../../../components/DateStrip.astro";
import FloorPanel from "../../../components/FloorPanel.astro";
import MapFrame from "../../../components/MapFrame.astro";
import MapPanel from "../../../components/MapPanel.astro";
import Shell from "../../../components/Shell.astro";
import { currentUser } from "../../../lib/auth";
import { buildingBySlug, errorMessage, levelsOf, roomsInBuilding } from "../../../lib/booking";
import { levelName, levelTag } from "../../../lib/levels";
import { buildingUrl, dayRedirect, roomSlug, roomUrl } from "../../../lib/links";
import { swatchVars } from "../../../lib/palette";
import { dateLabel, isBookableDate, today } from "../../../lib/slots";

// Two stages of the map on one URL. Without `floor`, the building's storeys
// fan apart and you pick a level; with it, the camera looks straight down on
// that level and you pick a room. A level that doesn't exist is the building
// stage — showing a guess would look like an answer.

const toDay = dayRedirect(Astro.url);
if (toDay) return Astro.redirect(toDay, 303);

const { slug } = Astro.params;
const building = slug ? buildingBySlug(slug) : undefined;
if (!building) return new Response("No such building", { status: 404 });

const user = currentUser(Astro.cookies);
const params = Astro.url.searchParams;
const requested = params.get("date") ?? today();
const date = isBookableDate(requested) ? requested : today();

// A level's rooms and desks are buttons in a GET form (a link each would be
// thousands of pages to a crawler), which lands here with `room=`: send it
// on to that room's own URL.
const picked = params.get("room");
const pickedRoom = picked
  ? roomsInBuilding(building.id).find((r) => roomSlug(r.code) === picked)
  : undefined;
const toRoom = pickedRoom ? roomUrl(building.slug, pickedRoom.code, { date }) : null;
if (toRoom) return Astro.redirect(toRoom, 303);

const requestedFloor = params.has("floor") ? Number(params.get("floor")) : NaN;
const floor =
  Number.isInteger(requestedFloor) && requestedFloor >= 0 && requestedFloor < building.levels
    ? requestedFloor
    : undefined;

const levels = levelsOf(building, date);
const rooms = levels.reduce((n, entry) => n + entry.rooms, 0);
const desks = levels.reduce((n, entry) => n + entry.desks, 0);
const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? "" : "s"}`;
const pct = (free: number, capacity: number) => Math.round((free / Math.max(1, capacity)) * 100);
const error = errorMessage(params.get("error"));
---

<Shell
  title={`${building.name}${floor === undefined ? "" : `, ${levelName(floor)}`} · ANU Room Booking`}
  current="map"
  user={user ?? undefined}
  layout="map"
>
  <MapFrame
    stage={floor === undefined ? "building" : "floor"}
    style={swatchVars(building.code)}
    scene={{
      date,
      focus: building.slug,
      floor,
      levels: levels.map((entry) => ({
        level: entry.level,
        rooms: entry.rooms,
        desks: entry.desks,
        free: entry.free / Math.max(1, entry.capacity),
      })),
    }}
  >
    {
      floor === undefined ? (
        <MapPanel label={building.name} noun="levels">
          <Fragment slot="head">
            <ol class="crumbs">
              <li>
                <a href={`/?date=${date}`}>Campus</a>
              </li>
              <li aria-current="page">{building.name}</li>
            </ol>
            <h1 class="mappanel-title">{building.name}</h1>
            <p class="mappanel-sub">
              <span class="code">{building.code}</span> · {building.levels}{" "}
              {building.levels === 1 ? "level" : "levels"} · {plural(rooms, "room")} ·{" "}
              {plural(desks, "desk")}
              <span class="live-only"> · pick a level on the map</span>
            </p>
            <DateStrip date={date} action={buildingUrl(building.slug)} />
            {error && <p class="notice notice-error">{error}</p>}
          </Fragment>

          <h2 class="mappanel-section">Levels · {dateLabel(date)}</h2>
          {/* top floor first, the way the storeys stack on the map */}
          <ol class="levels" reversed>
            {[...levels].reverse().map((entry) => (
              <li>
                <a
                  class="level"
                  href={buildingUrl(building.slug, { date, floor: entry.level })}
                  data-map-hover={`level:${entry.level}`}
                  style={`--fill:${pct(entry.free, entry.capacity)}%`}
                >
                  <b class="level-name code">{levelTag(entry.level)}</b>
                  <span class="level-meta">
                    {plural(entry.rooms, "room")} · {plural(entry.desks, "desk")}
                  </span>
                  <span class="level-stat">
                    {entry.capacity === 0 ? "—" : `${pct(entry.free, entry.capacity)}% free`}
                  </span>
                  <span class="meter" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ol>
        </MapPanel>
      ) : (
        <FloorPanel building={building} floor={floor} date={date} user={user ?? undefined} />
      )
    }
  </MapFrame>
</Shell>
