---
import BookingItem from "../components/BookingItem.astro";
import Shell from "../components/Shell.astro";
import { currentUser, nameOf } from "../lib/auth";
import { bookingsForUser, errorMessage } from "../lib/booking";
import { secondsUntilSlot, today } from "../lib/slots";

const user = currentUser(Astro.cookies);
const { now, upcoming, past } = user
    ? bookingsForUser(user.id)
    : { now: [], upcoming: [], past: [] };
const error =
    errorMessage(Astro.url.searchParams.get("error")) ??
    (Astro.url.searchParams.get("error") === "not-yours"
        ? "That booking isn't yours to cancel."
        : undefined);

// The next moment today one of these rows changes section — a booking under
// way ending, or one ahead starting — so an open tab can catch up then
// rather than saying "in progress" about something that's over.
const boundaries = [
    ...now.map((booking) => booking.endSlot),
    ...upcoming
        .filter((booking) => booking.date === today())
        .map((booking) => booking.startSlot),
];
const refreshIn = boundaries.length
    ? Math.max(1, secondsUntilSlot(Math.min(...boundaries)))
    : undefined;
---

<Shell
    title="My bookings · ANU Room Booking"
    current="bookings"
    user={user ?? undefined}
>
    <div class="page-head">
        <div>
            <h1>My bookings</h1>
            <p class="lede">
                {user
                    ? `Everything ${nameOf(user)} is holding, and everything already used.`
                    : "Rooms you've booked show up here."}
            </p>
        </div>
        <a class="btn" href="/">
            Find a room
        </a>
    </div>

    {error && <p class="notice notice-error">{error}</p>}

    {!user && (
        <div class="empty">
            <p>You're not signed in, so there's nothing to show yet.</p>
            <a class="btn btn-primary" href="/login/?next=%2Fbookings%2F">
                Sign in
            </a>
        </div>
    )}

    {user && (
        <div class="stack" data-refresh-in={refreshIn}>
            {now.length > 0 && (
                <section class="stack-sm">
                    <h2>Happening now ({now.length})</h2>
                    <ul class="rows">
                        {now.map((booking) => (
                            <BookingItem booking={booking} phase="now" />
                        ))}
                    </ul>
                </section>
            )}

            <section class="stack-sm">
                <h2>Coming up ({upcoming.length})</h2>
                {upcoming.length === 0 ? (
                    <div class="empty">
                        <p>Nothing booked. The campus map knows what's free.</p>
                        <a class="btn btn-primary" href="/">
                            Find a room
                        </a>
                    </div>
                ) : (
                    <ul class="rows">
                        {upcoming.map((booking) => (
                            <BookingItem booking={booking} phase="upcoming" />
                        ))}
                    </ul>
                )}
            </section>

            {past.length > 0 && (
                <section class="stack-sm">
                    <h2>Already been ({past.length})</h2>
                    <ul class="rows">
                        {past.slice(0, 20).map((booking) => (
                            <BookingItem booking={booking} phase="past" />
                        ))}
                    </ul>
                </section>
            )}
        </div>
    )}
</Shell>

<script>
    import { navigate } from "astro:transitions/client";

    // Re-render in place when a booking starts or ends (the server works out
    // when), a second late so the clock has definitely turned over.
    let timer: ReturnType<typeof setTimeout> | undefined;
    document.addEventListener("astro:page-load", () => {
        clearTimeout(timer);
        const seconds = Number(
            document.querySelector<HTMLElement>("[data-refresh-in]")?.dataset
                .refreshIn,
        );
        if (!seconds) return;
        timer = setTimeout(
            () => navigate(location.href, { history: "replace" }),
            (seconds + 1) * 1000,
        );
    });
</script>
